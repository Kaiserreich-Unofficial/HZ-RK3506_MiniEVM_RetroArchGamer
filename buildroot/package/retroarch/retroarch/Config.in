config BR2_PACKAGE_RETROARCH
	bool "retroarch"
	help
	  Cross-platform, sophisticated frontend for the libretro API.

	  http://www.libretro.com

comment "a frontend for emulators, game engines and media players"

if BR2_PACKAGE_RETROARCH

config BR2_PACKAGE_RETROARCH_RGUI
	bool "retroarch rgui"
	default y
	help
	  Support rgui menu.

config BR2_PACKAGE_RETROARCH_NETWORKING
	bool "retroarch networking"
	default y
	help
	  Support networking.

config BR2_PACKAGE_RETROARCH_HID
	bool "retroarch hid"
	default y
	select BR2_PACKAGE_LIBUSB
	help
	  Support hid inputs.

config BR2_PACKAGE_RETROARCH_ASSETS
        bool "retroarch assets"
        default y
        help
          Support assets GUI_icon.

config BR2_PACKAGE_RETROARCH_CONSOLE
	bool "retroarch console integration"
	help
	  Install the files that make RetroArch the system's front-end on a
	  dedicated console: /etc/retroarch.cfg defaults (RGUI, libretro dirs,
	  ROM browser at /root/roms), an init script that starts it at boot,
	  and a supervisor that restarts it whenever it exits so the device
	  never falls back to a blank framebuffer.

	  Only enable this on a device dedicated to RetroArch. It assumes the
	  root filesystem is writable for saves and states.

endif
