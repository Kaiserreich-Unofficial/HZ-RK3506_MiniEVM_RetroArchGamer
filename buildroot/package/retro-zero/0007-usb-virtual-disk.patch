+#include "usb_disk_gadget.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <dirent.h>
+#include <fstream>
+#include <string>
+#include <sys/stat.h>
+
+namespace {
+
+const char *kGadget = "/sys/kernel/config/usb_gadget/g1";
+const char *kMountPoint = "/root/roms";
+
+int run(const std::string &cmd)
+{
+    return std::system(cmd.c_str());
+}
+
+bool file_exists(const std::string &path)
+{
+    struct stat st;
+    return ::stat(path.c_str(), &st) == 0;
+}
+
+bool write_sysfs(const std::string &path, const std::string &value)
+{
+    std::ofstream f(path, std::ios::trunc);
+    if (!f.is_open())
+        return false;
+    f << value;
+    return f.good();
+}
+
+std::string read_first_udc()
+{
+    DIR *d = opendir("/sys/class/udc");
+    if (!d)
+        return std::string();
+    std::string name;
+    struct dirent *e;
+    while ((e = readdir(d)) != nullptr) {
+        if (e->d_name[0] == '.')
+            continue;
+        name = e->d_name;
+        break;
+    }
+    closedir(d);
+    return name;
+}
+
+// Same partition S20data mounts at /root/roms: the one whose uevent
+// advertises PARTNAME=data.
+bool find_data_partition(std::string &dev)
+{
+    DIR *d = opendir("/sys/block");
+    if (!d)
+        return false;
+    bool found = false;
+    struct dirent *disk;
+    while (!found && (disk = readdir(d)) != nullptr) {
+        if (strncmp(disk->d_name, "mmcblk", 6) != 0)
+            continue;
+        std::string base = std::string("/sys/block/") + disk->d_name;
+        DIR *pd = opendir(base.c_str());
+        if (!pd)
+            continue;
+        struct dirent *part;
+        while ((part = readdir(pd)) != nullptr) {
+            if (strncmp(part->d_name, disk->d_name, strlen(disk->d_name)) != 0)
+                continue;
+            std::string uevent = base + "/" + part->d_name + "/uevent";
+            std::ifstream f(uevent.c_str());
+            std::string line;
+            while (std::getline(f, line)) {
+                if (line.rfind("PARTNAME=data", 0) == 0) {
+                    dev = std::string("/dev/") + part->d_name;
+                    found = true;
+                    break;
+                }
+            }
+            if (found)
+                break;
+        }
+        closedir(pd);
+    }
+    closedir(d);
+    return found;
+}
+
+bool is_mounted()
+{
+    std::ifstream f("/proc/mounts");
+    std::string line;
+    while (std::getline(f, line)) {
+        if (line.find(kMountPoint) != std::string::npos &&
+            line.find(' ' + std::string(kMountPoint) + ' ') != std::string::npos)
+            return true;
+    }
+    return false;
+}
+
+void rebind_udc(const std::string &udc)
+{
+    if (!udc.empty())
+        write_sysfs(std::string(kGadget) + "/UDC", udc + "\n");
+}
+
+} // namespace
+
+namespace UsbDiskGadget {
+
+bool active()
+{
+    return file_exists(std::string(kGadget) + "/functions/mass_storage.0");
+}
+
+bool activate(std::string &error)
+{
+    if (active())
+        return true;
+
+    if (!file_exists(kGadget)) {
+        error = "USB gadget 未就绪";
+        return false;
+    }
+    std::string udc = read_first_udc();
+    if (udc.empty()) {
+        error = "未找到 USB 设备控制器";
+        return false;
+    }
+    std::string dev;
+    if (!find_data_partition(dev)) {
+        error = "未找到游戏数据分区";
+        return false;
+    }
+    if (is_mounted() && run(std::string("umount ") + kMountPoint) != 0) {
+        error = "数据分区正被占用，无法导出";
+        return false;
+    }
+
+    std::string G = kGadget;
+    // Drop the host connection while the composite config changes.
+    run(std::string("echo '' > ") + G + "/UDC");
+    run("mkdir -p " + G + "/functions/mass_storage.0");
+    if (!write_sysfs(G + "/functions/mass_storage.0/lun.0/file", dev + "\n")) {
+        error = "无法挂载存储 LUN";
+        return false;
+    }
+    write_sysfs(G + "/functions/mass_storage.0/lun.0/removable", "1\n");
+    run("rm -f " + G + "/configs/c.1/mass_storage.0");
+    run("ln -s " + G + "/functions/mass_storage.0 " + G + "/configs/c.1/mass_storage.0");
+    write_sysfs(G + "/strings/0x409/product", "RK3506 USB Disk\n");
+    rebind_udc(udc);
+    return true;
+}
+
+bool deactivate(std::string &error)
+{
+    (void)error;
+    std::string G = kGadget;
+    if (active()) {
+        run(std::string("echo '' > ") + G + "/UDC");
+        run("sleep 0.3"); // let the host release the LUN before the file goes away
+        run("rm -f " + G + "/configs/c.1/mass_storage.0");
+        run("rmdir " + G + "/functions/mass_storage.0");
+        write_sysfs(G + "/strings/0x409/product", "RK3506 Virtual Serial\n");
+        rebind_udc(read_first_udc());
+    }
+    // Make ROMs visible in the menu again.
+    if (!is_mounted()) {
+        std::string dev;
+        if (find_data_partition(dev))
+            run(std::string("mkdir -p ") + kMountPoint + " && mount -t vfat " + dev + " " + kMountPoint);
+    }
+    return true;
+}
+
+} // namespace UsbDiskGadget
