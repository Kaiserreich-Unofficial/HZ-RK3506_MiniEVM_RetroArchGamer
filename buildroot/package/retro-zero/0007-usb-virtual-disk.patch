+#ifndef CP0_USB_DISK_GADGET_H
+#define CP0_USB_DISK_GADGET_H
+
+#include <string>
+
+// Exposes the GAME data partition as a USB mass-storage LUN on the OTG port.
+// The g1 composite gadget (set up by S40usbserial) keeps its ttyGS0 ACM
+// function; this only adds/removes a mass_storage function and rebinds the UDC.
+namespace UsbDiskGadget {
+
+// umounts /root/roms, then adds the mass_storage function and rebinds.
+// Returns false with a user-presentable message in error.
+bool activate(std::string &error);
+
+// unbinds the LUN and mounts the partition back at /root/roms. Best effort;
+// always leaves the serial gadget bound.
+bool deactivate(std::string &error);
+
+// true while the mass_storage function exists in the gadget.
+bool active();
+
+} // namespace UsbDiskGadget
+
+#endif // CP0_USB_DISK_GADGET_H
