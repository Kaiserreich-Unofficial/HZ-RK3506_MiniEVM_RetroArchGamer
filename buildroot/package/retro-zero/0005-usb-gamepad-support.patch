--- a/src/UI/gamepad_translate.cpp	
+++ b/src/UI/gamepad_translate.cpp	
@@ -0,0 +1,124 @@
+#include "gamepad_translate.h"
+
+namespace {
+
+// Physical direction per axis slot (-1/0/1). Hysteresis: deflection must go
+// below 31 to register, but all the way back past 63 to release, so a value
+// hovering near the threshold cannot chatter.
+int g_axis_dir[4] = {};
+
+int axis_slot(int code)
+{
+    switch (code) {
+    case ABS_X: return 0;
+    case ABS_Y: return 1;
+    case ABS_HAT0X: return 2;
+    case ABS_HAT0Y: return 3;
+    default: return -1;
+    }
+}
+
+bool axis_is_y(int code)
+{
+    return code == ABS_Y || code == ABS_HAT0Y;
+}
+
+} // namespace
+
+namespace GamepadTranslate {
+
+int btn_to_joypad(int code)
+{
+    // Layer 1: modern pads following the kernel gamepad standard
+    // (Documentation/input/gamepad.rst - Xbox/PS layout: BTN_SOUTH=B,
+    // BTN_EAST=A, BTN_NORTH=X, BTN_WEST=Y). Covers any current-gen pad.
+    switch (code) {
+    case BTN_SOUTH: return RETRO_DEVICE_ID_JOYPAD_B;
+    case BTN_EAST: return RETRO_DEVICE_ID_JOYPAD_A;
+    case BTN_NORTH: return RETRO_DEVICE_ID_JOYPAD_X;
+    case BTN_WEST: return RETRO_DEVICE_ID_JOYPAD_Y;
+    case BTN_TL: return RETRO_DEVICE_ID_JOYPAD_L;
+    case BTN_TR: return RETRO_DEVICE_ID_JOYPAD_R;
+    case BTN_TL2: return RETRO_DEVICE_ID_JOYPAD_L2;
+    case BTN_TR2: return RETRO_DEVICE_ID_JOYPAD_R2;
+    case BTN_SELECT: return RETRO_DEVICE_ID_JOYPAD_SELECT;
+    case BTN_START: return RETRO_DEVICE_ID_JOYPAD_START;
+    case BTN_THUMBL: return RETRO_DEVICE_ID_JOYPAD_L3;
+    case BTN_THUMBR: return RETRO_DEVICE_ID_JOYPAD_R3;
+    default: break;
+    }
+
+    // Layer 2: legacy joystick codes (BTN_TRIGGER..BTN_BASE6), layout from
+    // RetroArch's community autoconfig database,
+    // profile "udev/Twin_USB_Joystick.cfg" - vendor 2064 (0x0810),
+    // product 1, exactly this pad:
+    //   A=BTN_THUMB B=BTN_THUMB2 X=BTN_TRIGGER Y=BTN_TOP,
+    //   L=BTN_BASE R=BTN_BASE2 L2=BTN_TOP2 R2=BTN_PINKIE,
+    //   SELECT=BTN_BASE3 START=BTN_BASE4.
+    switch (code) {
+    case BTN_TRIGGER: return RETRO_DEVICE_ID_JOYPAD_X;
+    case BTN_THUMB: return RETRO_DEVICE_ID_JOYPAD_A;
+    case BTN_THUMB2: return RETRO_DEVICE_ID_JOYPAD_B;
+    case BTN_TOP: return RETRO_DEVICE_ID_JOYPAD_Y;
+    case BTN_TOP2: return RETRO_DEVICE_ID_JOYPAD_L2;
+    case BTN_PINKIE: return RETRO_DEVICE_ID_JOYPAD_R2;
+    case BTN_BASE: return RETRO_DEVICE_ID_JOYPAD_L;
+    case BTN_BASE2: return RETRO_DEVICE_ID_JOYPAD_R;
+    case BTN_BASE3: return RETRO_DEVICE_ID_JOYPAD_SELECT;
+    case BTN_BASE4: return RETRO_DEVICE_ID_JOYPAD_START;
+    default: return -1;
+    }
+}
+
+int abs_update(int code, int value, DirChange out[2])
+{
+    const int slot = axis_slot(code);
+    if (slot < 0) return 0;
+
+    const bool hat = code == ABS_HAT0X || code == ABS_HAT0Y;
+    int dir = 0;
+    if (hat) {
+        dir = value; // -1 / 0 / 1
+    } else if (g_axis_dir[slot] == -1) {
+        dir = value <= 63 ? -1 : 0;
+    } else if (g_axis_dir[slot] == 1) {
+        dir = value >= 191 ? 1 : 0;
+    } else {
+        if (value <= 31) dir = -1;
+        else if (value >= 223) dir = 1;
+    }
+
+    const int prev = g_axis_dir[slot];
+    if (dir == prev) return 0;
+    g_axis_dir[slot] = dir;
+
+    const int neg = axis_is_y(code) ? RETRO_DEVICE_ID_JOYPAD_UP
+                                    : RETRO_DEVICE_ID_JOYPAD_LEFT;
+    const int pos = axis_is_y(code) ? RETRO_DEVICE_ID_JOYPAD_DOWN
+                                    : RETRO_DEVICE_ID_JOYPAD_RIGHT;
+
+    // Emit only the directions that actually change: release whatever was
+    // held, press the new one. A direct -1 -> +1 swing yields both.
+    int n = 0;
+    if (prev < 0) {
+        out[n].joypad_id = neg;
+        out[n].pressed = false;
+        ++n;
+    } else if (prev > 0) {
+        out[n].joypad_id = pos;
+        out[n].pressed = false;
+        ++n;
+    }
+    if (dir < 0) {
+        out[n].joypad_id = neg;
+        out[n].pressed = true;
+        ++n;
+    } else if (dir > 0) {
+        out[n].joypad_id = pos;
+        out[n].pressed = true;
+        ++n;
+    }
+    return n;
+}
+
+} // namespace GamepadTranslate
diff -ruN a/src/UI/gamepad_translate.h b/src/UI/gamepad_translate.h
--- a/src/UI/gamepad_translate.h	
+++ b/src/UI/gamepad_translate.h	
@@ -0,0 +1,30 @@
+#ifndef CP0_GAMEPAD_TRANSLATE_H
+#define CP0_GAMEPAD_TRANSLATE_H
+
+#include <linux/input.h>
+#include "libretro.h"
+
+// Native gamepad support, RetroArch-style: USB HID pads report BTN_* buttons
+// and ABS axes (D-pad as ABS_X/ABS_Y 0..255 or ABS_HAT0X/HAT0Y -1..1); this
+// module classifies those events into Libretro joypad ids. Nothing here
+// synthesizes keyboard events - the UI and EvdevInput consume joypad ids
+// directly, so the pad keeps its own layout instead of faking the Cardputer
+// keyboard.
+namespace GamepadTranslate {
+
+// Libretro joypad id for a gamepad button, or -1 when the EV_KEY code does
+// not belong to the pad (keyboard keys pass through unmapped).
+int btn_to_joypad(int code);
+
+// Hysteresis state machine for one D-pad axis report. Emits 0..2 direction
+// changes (a swing L->R without centering releases LEFT and presses RIGHT
+// atomically). Direction ids are RETRO_DEVICE_ID_JOYPAD_LEFT/RIGHT/UP/DOWN.
+struct DirChange {
+    int joypad_id;
+    bool pressed;
+};
+int abs_update(int code, int value, DirChange out[2]);
+
+} // namespace GamepadTranslate
+
+#endif // CP0_GAMEPAD_TRANSLATE_H
