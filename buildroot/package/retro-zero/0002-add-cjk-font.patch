diff --git a/lv_conf.h b/lv_conf.h
index c7fb4cf..305dc35 100644
--- a/lv_conf.h
+++ b/lv_conf.h
@@ -35,4 +35,20 @@
 #define LV_USE_ASSERT_MEM_INTEGRITY 0
 #define LV_USE_ASSERT_OBJ 0
 
+
+// Filesystem access: needed by tiny_ttf to load the CJK font from the
+// root filesystem. The 'A:' prefix in LVGL paths is stripped and the rest is
+// passed to fopen() as an absolute path (LV_FS_STDIO_PATH is empty).
+#define LV_USE_FS_STDIO 1
+#define LV_FS_STDIO_LETTER 'A'
+#define LV_FS_STDIO_PATH ""
+#define LV_FS_STDIO_CACHE_SIZE 0
+
+// TrueType renderer (stb_truetype based, no external library). Latin-only
+// built-in fonts cannot display Chinese filenames.
+#define LV_USE_TINY_TTF 1
+// FILE_SUPPORT defaults to 0, which hides lv_tiny_ttf_create_file()
+#define LV_TINY_TTF_FILE_SUPPORT 1
+#define LV_TINY_TTF_CACHE_GLYPH_CNT 200
+#define LV_TINY_TTF_USE_IO_BUFFER 0
 #endif
