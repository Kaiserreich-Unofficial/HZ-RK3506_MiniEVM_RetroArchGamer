diff --git a/src/UI/cjk_font.cpp b/src/UI/cjk_font.cpp
new file mode 100644
index 0000000..f0fa568
--- /dev/null
+++ b/src/UI/cjk_font.cpp
@@ -0,0 +1,48 @@
+#include "cjk_font.h"
+
+#include <cstdio>
+
+// Latin-only built-in faces cannot display Chinese filenames, so the UI text
+// is switched to a TrueType with CJK coverage once it is loaded from the root
+// filesystem. tiny_ttf reads glyphs on demand through lv_fs, so the whole file
+// is never resident.
+
+#ifndef CP0_CJK_FONT_PATH
+#define CP0_CJK_FONT_PATH "A:/usr/share/fonts/wqy-cjk.ttf"
+#endif
+
+const lv_font_t *cjk_font_10 = &lv_font_montserrat_10;
+const lv_font_t *cjk_font_12 = &lv_font_montserrat_12;
+const lv_font_t *cjk_font_20 = &lv_font_montserrat_20;
+const lv_font_t *cjk_font_28 = &lv_font_montserrat_28;
+
+bool cjk_fonts_init()
+{
+    struct Slot {
+        int32_t size;
+        const lv_font_t **font;
+    };
+
+    const Slot slots[] = {
+        { 10, &cjk_font_10 },
+        { 12, &cjk_font_12 },
+        { 20, &cjk_font_20 },
+        { 28, &cjk_font_28 },
+    };
+
+    bool loaded = false;
+    for (const Slot &s : slots) {
+        lv_font_t *face = lv_tiny_ttf_create_file(CP0_CJK_FONT_PATH, s.size);
+        if (face) {
+            *s.font = face;
+            loaded = true;
+        }
+    }
+
+    if (!loaded) {
+        std::fprintf(stderr,
+                     "cp0-retro: CJK font %s unavailable, keeping Latin-only Montserrat\n",
+                     CP0_CJK_FONT_PATH);
+    }
+    return loaded;
+}
diff --git a/src/UI/cjk_font.h b/src/UI/cjk_font.h
new file mode 100644
index 0000000..f16d5da
--- /dev/null
+++ b/src/UI/cjk_font.h
@@ -0,0 +1,19 @@
+#ifndef CP0_CJK_FONT_H
+#define CP0_CJK_FONT_H
+
+#include <lvgl.h>
+
+// CJK-capable text fonts. Before cjk_fonts_init() runs they point at the
+// built-in Montserrat faces, which only cover Latin — so Chinese filenames
+// would draw as missing glyphs.
+extern const lv_font_t *cjk_font_10;
+extern const lv_font_t *cjk_font_12;
+extern const lv_font_t *cjk_font_20;
+extern const lv_font_t *cjk_font_28;
+
+// Loads the CJK TrueType via LVGL's tiny_ttf at the sizes the UI uses.
+// If the font file is unavailable the Montserrat fallbacks stay in place and
+// false is returned; the UI still works, just without Chinese glyphs.
+bool cjk_fonts_init();
+
+#endif // CP0_CJK_FONT_H
