#include "base/base.config"
#include "chips/rk3506_arm.config"
#include "fs/vfat.config"
# Cap build parallelism. The default (0 = 1 + nproc) spawns one job per core,
# which on a many-core-but-low-memory host (20 cores / 9GB here) exhausts RAM
# and corrupts build output: host-libopenssl dies with "Bus error (core
# dumped)" and "libcrypto.a: error adding symbols: file format not recognized",
# and its parallel .d files race ("mv: cannot stat '...d.tmp'"). A build that
# emitted a broken image is worse than a slower correct one.
BR2_JLEVEL=8
# --- audio (alsa only, no pulseaudio: retroarch talks to alsa directly) ---
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_ROCKCHIP_ALSA_CONFIG=y
# --- data partition: mkfs.vfat on first boot (S20data) ---
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKDOSFS=y
# sfdisk: fix the data partition's RK-proprietary GPT type GUID to
# "Microsoft basic data", otherwise Windows hides it (no drive letter)
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_UTIL_LINUX_LIBMOUNT=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
# --- input debug ---
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_IPROUTE2=y
# --- ethernet + file transfer: board is reachable at fixed 192.168.10.1;
# S45ftpd serves /root over anonymous FTP (busybox ftpd via tcpsvd) ---
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/rockchip/common/base/busybox.fragment board/rockchip/rk3506/busybox-game.fragment"
# MP3 playback for the Retro-Zero Music card (music_player spawns its CLI)
BR2_PACKAGE_MPG123=y
# --- retroarch: KMS/DRM software video driver (RK3506 has no GPU) ---
BR2_PACKAGE_LIBDRM=y
# --- frontend: Retro-Zero (LVGL UI, draws straight to /dev/fb0; no GPU needed).
# Replaces RetroArch, which is no longer built. ---
BR2_PACKAGE_RETRO_ZERO=y
# boot straight into it: init script + respawn supervisor
BR2_PACKAGE_RETRO_ZERO_CONSOLE=y
BR2_PACKAGE_LIBRETRO_MGBA=y
# --- cores: FC/NES, GB/GBC, SFC(SNES), MD/SMS/GG (all ARM-friendly) ---
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_SNES9X2005=y
BR2_PACKAGE_LIBRETRO_PICODRIVE=y
# RetroArch and its SDL driver are gone; the cores above are frontend-agnostic
# and Retro-Zero draws to /dev/fb0 itself, so SDL is not built at all.
# BR2_PACKAGE_RETROARCH is not set
# BR2_PACKAGE_SDL is not set
BR2_ROOTFS_OVERLAY+="board/rockchip/rk3506/fs-retrogaming-overlay/"
