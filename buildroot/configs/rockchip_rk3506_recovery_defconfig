#include "base/base.config"
#include "base/recovery.config"
#include "chips/rk3506_arm.config"
# See rockchip_rk3506_game_defconfig: 0 means one job per core, which exhausts
# memory on a many-core/low-RAM host and corrupts host-libopenssl's output.
