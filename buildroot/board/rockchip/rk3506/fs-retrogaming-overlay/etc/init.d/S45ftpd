#!/bin/sh
# Guest FTP rooted at /root for pushing ROMs and music over the network
# (fixed board address 192.168.10.1, see /etc/network/interfaces).
# busybox ftpd is built without authentication, so any login is accepted
# and runs as root: anonymous read/write/upload to /root/roms + /root/saves.
# Enabled busybox applets: ftpd (+FEATURE_FTPD_WRITE) and tcpsvd.

case "$1" in
  start)
    tcpsvd -vE 0.0.0.0 21 ftpd -w /root 2>/dev/null &
    ;;
  stop)
    killall tcpsvd 2>/dev/null
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
