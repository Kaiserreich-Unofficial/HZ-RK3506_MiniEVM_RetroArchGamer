# Fixed address so a PC can always reach the board (FTP on port 21,
# ROM upload server) without DHCP: plug in a cable and point the peer at
# 192.168.10.1, e.g. PC static 192.168.10.2/255.255.255.0.
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address 192.168.10.1
    netmask 255.255.255.0
