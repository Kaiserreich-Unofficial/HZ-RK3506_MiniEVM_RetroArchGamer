# Game console display + audio
# SPI screen ILI9341 (tinydrm); audio via USB sound card (USB Audio Class)
CONFIG_TINYDRM_ILI9341=y
CONFIG_BACKLIGHT_GPIO=y
# USB sound card (card 0 when no other sound card exists)
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
# USB hub support (expansion dock); hubs are handled by usbcore, but
# make sure host-side HID joysticks get joydev nodes too
CONFIG_INPUT_JOYSTICK=y
# USB OTG as gadget: serial (ttyGS0)
CONFIG_USB_DWC2=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
# ttyGS0 as kernel console
CONFIG_U_SERIAL_CONSOLE=y
# boot logo (RetroArch) on fbcon; fbcon+logo require VT
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# Chinese filenames on the FAT32 data partition must reach userspace as UTF-8:
# the defaults (iso8859-1, utf8 off) mangle them in-kernel, which no font can
# undo. CONFIG_FAT_DEFAULT_UTF8 makes "utf8" the default mount option.
CONFIG_NLS_UTF8=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
